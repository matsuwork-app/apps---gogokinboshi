# Public read-only Supabase connection
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only mutation credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# LINE is the secure default, including when this variable is missing or misspelled.
# Use "legacy" only for isolated migration checks; never for production launch.
ACCESS_MODE=line
NEXT_PUBLIC_SITE_URL=http://localhost:3000
LINE_ADMIN_USER_ID=

# Emergency legacy session verification (there is no passcode UI).
MANAGER_SESSION_SECRET=
